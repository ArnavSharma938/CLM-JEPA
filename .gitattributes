*.safetensors filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.sh text eol=lf

# Released/full benchmark datasets are versioned, but stored through LFS.
data/metatrans/** filter=lfs diff=lfs merge=lfs -text
data/non_uspto_forward/** filter=lfs diff=lfs merge=lfs -text
data/non_uspto_retro/** filter=lfs diff=lfs merge=lfs -text
data/orderly_forward/** filter=lfs diff=lfs merge=lfs -text
data/uspto_480k_template_heldout/** filter=lfs diff=lfs merge=lfs -text
data/uspto_50k/** filter=lfs diff=lfs merge=lfs -text
data/uspto_mit_synthesis/** filter=lfs diff=lfs merge=lfs -text

# Vendored upstream sources are retained byte-for-byte for fidelity audits.
references/** -whitespace

# The frozen panel hash includes its original CRLF byte serialization.
data/clm_jepa_uspto_mit_validation_1024/*.csv -text -whitespace

# Frozen official endpoint manifests are byte-identified in reports and must
# not be rewritten by platform line-ending conversion.
data/clm_jepa_uspto_mit_official_endpoint/*.jsonl -text -whitespace
data/clm_jepa_uspto_mit_stp_confirmation/*.json -text -whitespace
data/clm_jepa_uspto_mit_stp_confirmation/*.jsonl -text -whitespace
data/clm_jepa_uspto_mit_latent_audit/*.json -text -whitespace
